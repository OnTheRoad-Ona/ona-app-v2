{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/jobs/expire-stale",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/pairing-sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/payments/payout-retry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/egress-ip",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/notification-retry",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/analytics-rollup",
      "schedule": "45 8 * * *"
    }
  ]
}