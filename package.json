{
  "name": "ona",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname :: --port 3000",
    "dev:open": "open http://127.0.0.1:3000",
    "dev:admin": "NEXT_DIST_DIR=.next-admin next dev --hostname :: --port 4500",
    "dev:admin:open": "open http://127.0.0.1:4500/admin",
    "build": "next build",
    "start": "next start --port 3000",
    "start:admin": "NEXT_DIST_DIR=.next-admin next start --port 4500",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:apply": "node scripts/apply-schema.mjs",
    "db:sync": "node scripts/sync-db-latest.mjs",
    "db:setup": "node scripts/apply-schema.mjs && node scripts/seed-admin.mjs && node scripts/sync-db-latest.mjs",
    "db:seed-mechanic": "node scripts/seed-mechanic-taxonomy.mjs",
    "db:seed-automedics": "npx tsx scripts/shop-seed-automedics.mts",
    "backup:local": "node \"Local BackUp/scripts/backup-db.mjs\"",
    "backup:local:watch": "node \"Local BackUp/scripts/schedule-24h.mjs\"",
    "vehicles:catalog": "node scripts/download-vehicle-catalog.mjs",
    "vercel": "vercel",
    "vercel:login": "vercel login",
    "vercel:link": "vercel link",
    "vercel:env": "vercel env pull .env.vercel.local",
    "deploy:frontend": "vercel --prod --yes --project ona-mi",
    "deploy:backend": "vercel --prod --yes --project ona-backend",
    "deploy:both": "npm run deploy:backend && npm run deploy:frontend"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.110.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "nigeria-state-lga-data": "^1.1.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/google.maps": "^3.65.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vercel": "^56.5.0",
    "vitest": "^4.1.10"
  }
}
